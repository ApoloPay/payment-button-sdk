{
  "name": "@apolo-pay/wordpress-plugin",
  "version": "1.2.0",
  "private": true,
  "description": "WooCommerce Payment Gateway for ApoloPay",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ApoloPay/payment-button-sdk.git"
  },
  "main": "apolo-pay.php",
  "scripts": {
    "build": "node scripts/copy-build.js && npm run zip",
    "zip": "bestzip dist/apolopay-checkout-for-woocommerce.zip apolo-pay.php includes/ assets/ languages/ readme.txt",
    "clean": "rimraf dist assets/apolopay-sdk.js"
  },
  "devDependencies": {
    "@apolopay-sdk/ui": "workspace:*",
    "bestzip": "^2.2.1",
    "rimraf": "^5.0.0"
  },
  "keywords": [
    "woocommerce",
    "apolo-pay",
    "payment-gateway",
    "wordpress"
  ]
}