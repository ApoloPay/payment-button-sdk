{
  "name": "@nexora-smartpay/vue",
  "version": "2.0.0",
  "description": "Nexora SmartPay payment button adapter for Vue",
  "author": "Nexora SmartPay",
  "homepage": "https://smartpaylatam.com",
  "keywords": [
    "nexora",
    "smartpay",
    "nexora-smartpay",
    "payments",
    "crypto",
    "payment-button",
    "vue"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nexora-SmartPay/nexora_smartpay_sdk.git",
    "directory": "javascript-sdk/packages/vue"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --clean --external vue",
    "dev": "tsup src/index.tsx --format esm,cjs --dts --watch --external vue"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@nexora-smartpay/ui": "workspace:*"
  },
  "devDependencies": {
    "tsup": "8.0.0",
    "typescript": "5.4.5",
    "vue": "3.0.0"
  },
  "peerDependencies": {
    "vue": "3.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  }
}