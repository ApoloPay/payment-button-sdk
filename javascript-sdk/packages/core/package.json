{
  "name": "@nexora-smartpay/core",
  "version": "2.0.0",
  "license": "MIT",
  "sideEffects": false,
  "description": "Core SDK for Nexora SmartPay",
  "author": "Nexora SmartPay",
  "homepage": "https://smartpaylatam.com",
  "keywords": [
    "nexora",
    "smartpay",
    "nexora-smartpay",
    "payments",
    "crypto",
    "payment-button",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nexora-SmartPay/nexora_smartpay_sdk.git",
    "directory": "javascript-sdk/packages/core"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "socket.io-client": "4.8.3"
  },
  "devDependencies": {
    "tsup": "8.5.0",
    "typescript": "5.4.5",
    "vitest": "^4.1.11"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  }
}