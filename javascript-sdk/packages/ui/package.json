{
  "name": "@nexora-smartpay/ui",
  "version": "2.0.0",
  "description": "Nexora SmartPay UI components (Web Components) for the payment button",
  "author": "Nexora SmartPay",
  "homepage": "https://smartpaylatam.com",
  "keywords": [
    "nexora",
    "smartpay",
    "nexora-smartpay",
    "payments",
    "crypto",
    "payment-button",
    "web-components"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nexora-SmartPay/nexora_smartpay_sdk.git",
    "directory": "javascript-sdk/packages/ui"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/nexora-smartpay.umd.js",
  "module": "./dist/nexora-smartpay.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly && vite build",
    "dev": "vite build --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@nexora-smartpay/core": "workspace:*",
    "lit": "3.0.0",
    "tslib": "2.8.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nexora-smartpay.es.js",
      "require": "./dist/nexora-smartpay.umd.js"
    }
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "jsdom": "^30.0.1",
    "typescript": "5.4.5",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  }
}